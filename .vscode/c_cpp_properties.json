{
  "version": 4,
  "configurations": [
    {
      "name": "MSVC x64",
      "configurationProvider": "ms-vscode.cmake-tools",
      "compileCommands": "${workspaceFolder}/build/msvc-debug/compile_commands.json",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src",
        "${env:VULKAN_SDK}/Include"
      ]
    }
  ]
}
